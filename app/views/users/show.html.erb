<div class="container-fluid py-4 px-3 px-lg-5">
  <!-- プロフィールヘッダー -->
  <div class="d-flex justify-content-between align-items-start mb-4 pb-3 border-bottom">

    <!-- 左：アイコン＋情報 -->
    <div class="d-flex align-items-center gap-3">

      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, class: "avatar-img" %>
      <% else %>
        <div class="avatar-img bg-secondary-subtle d-flex align-items-center justify-content-center">
          <i class="bi bi-person fs-3"></i>
        </div>
      <% end %>

      <div>
        <h1 class="h4 fw-bold mb-1">
          <%= @user.username.presence || "名無しユーザー" %>
        </h1>

        <div class="d-flex gap-2 flex-wrap mb-2">
          <div class="px-3 py-1 border rounded-pill small text-muted">
            <strong class="text-dark"><%= @posts.count %></strong> 投稿
          </div>

          <%= link_to likes_user_path(@user),
              class: "px-3 py-1 border rounded-pill small text-decoration-none d-inline-flex align-items-center gap-1 like-chip" do %>
            <i class="bi bi-heart-fill"></i>
            <strong><%= @user.likes.count %></strong>
            <span class="text-muted">
              <%= (user_signed_in? && current_user == @user) ? "いいね一覧" : "いいね" %>
            </span>
          <% end %>
        </div>

        <% if @user.profile.present? %>
          <p class="text-muted mb-0">
            <%= simple_format(@user.profile) %>
          </p>
        <% else %>
          <p class="text-muted mb-0 small">
            プロフィールが未設定です
          </p>
        <% end %>
      </div>
    </div>

    <!-- 右：編集ボタン -->
    <% if user_signed_in? && current_user == @user %>
      <div>
        <%= link_to "プロフィール編集",
            edit_user_registration_path,
            class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>

  </div>

  <!-- 投稿一覧（完全に別ブロック） -->
  <div class="home-masonry">
    <% @posts.each do |post| %>
      <div class="home-masonry-item">
        <%= render "posts/pin", post: post %>
      </div>
    <% end %>
  </div>
</div>