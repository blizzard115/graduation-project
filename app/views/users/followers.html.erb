<div class="container-fluid py-4 px-3 px-lg-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h4 fw-bold mb-1"><%= @user.username.presence || "名無しユーザー" %> のフォロワー</h1>
      <div class="text-muted small"><%= @users.count %> 人</div>
    </div>

    <%= link_to "プロフィールへ戻る", user_path(@user), class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <% if @users.any? %>
    <div class="list-group">
      <% @users.each do |u| %>
        <%= link_to user_path(u), class: "list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" do %>
          <% if u.avatar.attached? %>
            <%= image_tag u.avatar, class: "avatar-sm" %>
          <% else %>
            <div class="avatar-sm bg-secondary-subtle d-flex align-items-center justify-content-center">
              <i class="bi bi-person"></i>
            </div>
          <% end %>

          <div class="fw-semibold"><%= u.username.presence || "名無しユーザー" %></div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-muted">フォロワーはいません。</div>
  <% end %>
</div>
