<!DOCTYPE html>
<html>
  <head>
    <title>Stylog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <!-- favicon -->
    <%= favicon_link_tag 'logo.svg' %>

    <!-- OGP -->
    <% ogp_image_url = "#{request.base_url}/stylog-ogp.png" %>

    <meta property="og:title" content="Stylog - コーデをもっと気軽に" />
    <meta property="og:description" content="写真1枚 + ひとこと で投稿できるコーデ記録アプリ" />
    <meta property="og:image" content="<%= ogp_image_url %>" />
    <meta property="og:url" content="<%= request.original_url %>" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stylog" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Stylog - コーデをもっと気軽に" />
    <meta name="twitter:description" content="写真1枚 + ひとこと で投稿できるコーデ記録アプリ" />
    <meta name="twitter:image" content="<%= ogp_image_url %>" />

  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
  <div class="container-fluid px-4">
    <%= link_to "Stylog", root_path, class: "navbar-brand fw-bold" %>

    <div class="ms-auto d-flex align-items-center gap-2">
      <% if user_signed_in? %>
        <%= link_to new_post_path, class: "btn btn-dark btn-sm px-3 rounded-pill" do %>
          <i class="fa-solid fa-plus me-1"></i> 投稿
        <% end %>

        <div class="dropdown">
          <button class="btn btn-outline-secondary btn-sm rounded-pill dropdown-toggle"
                  type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-regular fa-user me-1"></i>
          </button>

          <ul class="dropdown-menu dropdown-menu-end">
            <li>
              <%= link_to user_path(current_user), class: "dropdown-item" do %>
                <i class="fa-regular fa-user me-2"></i> マイページ
              <% end %>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= button_to destroy_user_session_path,
                method: :delete,
                class: "dropdown-item text-danger",
                form: { class: "d-inline" } do %>
                <i class="fa-solid fa-right-from-bracket me-2"></i> ログアウト
              <% end %>
            </li>
          </ul>
        </div>

      <% else %>
        <%= link_to new_user_session_path, class: "btn btn-outline-secondary btn-sm rounded-pill" do %>
          ログイン
        <% end %>
        <%= link_to new_user_registration_path, class: "btn btn-dark btn-sm px-3 rounded-pill" do %>
          はじめる
        <% end %>
      <% end %>
    </div>
  </div>
</nav>


    <main class="flex-grow-1">
      <% if controller_name == "home" && action_name == "index" %>
        <%# LPは全幅で出す %>
        <%= yield %>
      <% else %>
        <div class="container-fluid py-4 px-4">
          <% if notice %>
            <div class="alert alert-info"><%= notice %></div>
          <% end %>

          <% if alert %>
            <div class="alert alert-warning"><%= alert %></div>
          <% end %>

          <%= yield %>
        </div>
      <% end %>
    </main>

    <footer class="border-top py-3 bg-light">
      <div class="container small text-muted">
        © <%= Time.current.year %> Stylog
      </div>
    </footer>
  </body>
</html>

