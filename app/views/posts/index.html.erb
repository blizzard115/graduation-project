<div class="container-fluid py-4 px-3 px-lg-5">

  <div class="mb-3">
    <%= form_with url: posts_path, method: :get, local: true do %>
      <div class="input-group">
        <%= text_field_tag :tag, params[:tag], class: "form-control", placeholder: "タグを検索（例: スポーティ）" %>
        <button type="submit" class="btn btn-outline-secondary">検索</button>
      </div>
    <% end %>

    <% if params[:tag].present? %>
      <p class="text-muted mt-2 mb-0">
        タグ「<strong><%= params[:tag] %></strong>」の検索結果
      </p>
    <% end %>
  </div>

  <div class="home-masonry">
    <% @posts.each do |post| %>
      <div class="home-masonry-item">
        <%= render "posts/pin", post: post %>
      </div>
    <% end %>
  </div>
</div>
