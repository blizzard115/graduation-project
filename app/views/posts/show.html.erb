<div class="container-fluid py-4 px-3 px-lg-5">
  <div class="row g-4 justify-content-center">

    <!-- 左：画像（主役） -->
    <div class="col-12 col-lg-7">
      <div class="card shadow-sm post-show-media position-relative">

        <div class="card-body p-0">
          <% if @post.image.attached? %>
            <%= image_tag @post.image, class: "post-show-img" %>
          <% end %>
        </div>

        <!-- ここがオーバーレイ（画像の上に重ねる） -->
        <div class="post-like-overlay">
          <div class="d-flex align-items-center gap-2">
            <%= render "likes/button", post: @post %>
            <span class="post-like-count"><%= @post.likes_count %></span>
          </div>
        </div>

      </div>
    </div>

    <!-- 右：メタ情報 + アクション + コメント（固定幅カード） -->
    <div class="col-12 col-lg-5">
      <div class="post-show-side">
        <div class="card shadow-sm post-show-card">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
              <% if @post.user&.avatar&.attached? %>
                <%= image_tag @post.user.avatar, class: "avatar-sm" %>
              <% else %>
                <div class="avatar-sm bg-secondary-subtle d-flex align-items-center justify-content-center">
                  <i class="bi bi-person"></i>
                </div>
              <% end %>

              <div class="small">
                <div class="fw-semibold">
                  <%= link_to (@post.user&.username || @post.user&.email),
                    user_path(@post.user),
                    class: "text-decoration-none text-dark" %>
                </div>
                <div class="text-muted">
                  <%= @post.created_at.strftime("%Y/%m/%d %H:%M") %>
                </div>
              </div>
            </div>

            <div>
              <% if user_signed_in? %>
                <%= render "relationships/button", user: @post.user unless @post.user == current_user %>
              <% end %>
            </div>
          </div>

          <div class="card-body">

            <!-- タグ -->
            <% if @post.tags.any? %>
              <div class="d-flex flex-wrap gap-1 mb-2">
                <% @post.tags.each do |tag| %>
                  <%= link_to "##{tag.name}", tag_path(tag.name),
                    class: "badge rounded-pill text-bg-light border text-decoration-none" %>
                <% end %>
              </div>
            <% end %>

            <!-- 本文 -->
            <% if @post.content.present? %>
              <p class="mb-3 post-show-content"><%= simple_format(@post.content) %></p>
            <% else %>
              <p class="text-muted mb-3">本文はありません</p>
            <% end %>
            
            <!-- 投稿者のみ -->
            <% if user_signed_in? && @post.user == current_user %>
              <div class="d-flex gap-2 mb-3">
                <%= link_to "編集", edit_post_path(@post), class: "btn btn-sm btn-outline-secondary" %>
                <%= button_to "削除", post_path(@post), method: :delete,
                      data: { turbo_confirm: "削除しますか？" },
                      class: "btn btn-sm btn-outline-danger" %>
              </div>
            <% end %>

             <!-- コメント -->
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="mb-0">コメント</h6>
              <span class="text-muted small"><%= @post.comments.count %>件</span>
            </div>

            <div class="mt-3 post-comments-list">
              <% @post.comments.order(created_at: :desc).each do |comment| %>
                <div class="comment-item py-2">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <strong><%= comment.user.username || "名無しユーザー" %></strong>
                      <span class="text-muted small">（<%= comment.created_at.strftime("%Y/%m/%d %H:%M") %>）</span>
                    </div>

                    <% if user_signed_in? && comment.user == current_user %>
                      <%= button_to "削除", post_comment_path(@post, comment),
                            method: :delete,
                            data: { confirm: "削除しますか？" },
                            class: "btn btn-sm btn-outline-danger" %>
                    <% end %>
                  </div>
                  <p class="mb-1"><%= simple_format(comment.content) %></p>
                </div>
              <% end %>
            </div>

            <hr class="my-3">

            <% if user_signed_in? %>
              <%= form_with model: [@post, Comment.new], local: true do |f| %>
                <div class="mb-2">
                  <%= f.text_area :content, rows: 2, class: "form-control", placeholder: "コメントを入力..." %>
                </div>
                <div class="d-flex">
                  <%= f.submit "送信", class: "btn btn-primary btn-sm ms-auto" %>
                </div>
              <% end %>
            <% else %>
              <p class="mb-0"><%= link_to "ログイン", new_user_session_path %>するとコメントできます</p>
            <% end %>

          </div>
        </div>
      </div>
    </div>

  </div>
</div>
