<%= form_with model: post, local: true, data: { controller: "preview loading", action: "submit->loading#submit" }, html: { class: "post-form" } do |f| %>
  <% if post.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="card shadow-sm border-0 post-form-card">
    <div class="card-body p-4">
      <div class="row g-4">

        <!-- 左：入力エリア -->
        <div class="col-12 col-lg-6">
          <div class="mb-3">
            <%= f.label :content, "キャプション", class: "form-label fw-semibold" %>
            <%= f.text_area :content, rows: 8, class: "form-control", placeholder: "今日のコーデのポイント、ブランド、気分など…" %>
            <div class="form-text">写真＋ひとこと。まずは気軽に。</div>
          </div>

          <div class="mb-3">
            <%= label_tag :tag_names, "タグ（カンマ区切り）", class: "form-label fw-semibold" %>
            <%= text_field_tag "post[tag_names]",
                  (post.tag_names.presence || post.tags.pluck(:name).join(", ")),
                  class: "form-control",
                  placeholder: "street, monochrome, vintage" %>
            <div class="form-text">例：street, monochrome</div>
          </div>

          <hr class="my-4">

          <h6 class="fw-semibold mb-3">この日の記録</h6>

          <div class="mb-3">
            <%= f.label :worn_on, "着用日", class: "form-label fw-semibold" %>
            <%= f.date_field :worn_on, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :temperature, "気温", class: "form-label fw-semibold" %>
            <div class="input-group">
              <%= f.number_field :temperature, class: "form-control", placeholder: "例: 18" %>
              <span class="input-group-text">℃</span>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :weather, "天気", class: "form-label fw-semibold" %>
            <%= f.select :weather,
                [["晴れ", "sunny"], ["くもり", "cloudy"], ["雨", "rainy"], ["雪", "snowy"]],
                {},
                class: "form-select" %>
          </div>

          <div class="mb-3">
            <%= f.label :scene, "シーン", class: "form-label fw-semibold" %>
            <%= f.select :scene,
                [["外出", "casual_outing"], ["通勤", "commuting"], ["通学", "school"], ["デート", "date"], ["旅行", "travel"], ["買い物", "shopping"], ["カフェ", "cafe"], ["フォーマル", "formal"]],
                {},
                class: "form-select" %>
          </div>

          <div class="d-flex gap-2 mt-4">
            <%= link_to "キャンセル", posts_path, class: "btn btn-outline-secondary" %>
            <%= f.submit(post.persisted? ? "更新する" : "投稿する", class: "btn btn-primary px-4 ms-auto", data: { turbo_submits_with: "投稿中..." }) %>
          </div>
        </div>

        <!-- 右：プレビュー -->
        <div class="col-12 col-lg-6">
          <div class="post-preview card border-0">
            <% image_invalid = post.errors[:image].present? %>

            <div class="post-preview-inner <%= "is-invalid" if image_invalid %>">
              <%= f.file_field :image,
                    accept: "image/*",
                    required: post.new_record?,
                    class: "post-preview-input",
                    data: { preview_target: "input" } %>

              <% if post.persisted? && post.image.attached? %>
                <%= image_tag post.image,
                      class: "post-preview-img",
                      data: { preview_target: "img" },
                      alt: "preview" %>
              <% else %>
                <%= image_tag "",
                      class: "post-preview-img d-none",
                      data: { preview_target: "img" },
                      alt: "preview" %>
              <% end %>

              <div class="post-preview-placeholder text-muted <%= post.persisted? && post.image.attached? ? "d-none" : "" %>"
                  data-preview-target="placeholder">
                <div class="mb-2">
                  <i class="bi bi-image fs-1"></i>
                </div>
                <p class="mb-1">画像を選択してください</p>
                <small>画像を選択するとここにプレビューが表示されます</small>
              </div>
            </div>

            <% if image_invalid %>
              <div class="invalid-feedback d-block">
                <%= post.errors[:image].first %>
              </div>
            <% end %>

            <div class="mt-2 small text-muted">
              推奨：縦長（4:5）／明るめの写真が映えます
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
<% end %>