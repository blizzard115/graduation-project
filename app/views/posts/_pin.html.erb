<div class="pin">
  <%= link_to post_path(post), class: "pin__media d-block" do %>
    <% if post.image.attached? %>
      <%= image_tag post.image_masonry.processed, class: "pin__img", loading: "lazy" %>
    <% else %>
      <div class="pin__placeholder">No Image</div>
    <% end %>
  <% end %>

  <div class="pin__meta">
    <div class="d-flex align-items-center gap-2 min-w-0">
      <% if post.user&.avatar&.attached? %>
        <%= image_tag post.user.avatar, class: "avatar-xs" %>
      <% else %>
        <div class="avatar-xs bg-secondary-subtle d-flex align-items-center justify-content-center">
          <i class="bi bi-person"></i>
        </div>
      <% end %>

      <% if post.user %>
        <%= link_to(post.user.username.presence || "名無しユーザー",
                    user_path(post.user),
                    class: "pin__user text-decoration-none text-dark") %>
      <% else %>
        <span class="pin__user text-muted">名無しユーザー</span>
      <% end %>
    </div>

    <div class="pin__actions d-flex align-items-center gap-1">
      <% if user_signed_in? %>
        <%= render "likes/button", post: post %>
      <% else %>
        <%= link_to new_user_session_path, class: "like-btn", title: "ログインするといいねできます" do %>
          <i class="bi bi-heart"></i>
        <% end %>
      <% end %>
      <span class="small text-muted"><%= post.likes_count %></span>
    </div>
  </div>
</div>
