<% if user_signed_in? && current_user != user %>
  <% rel = @following_relationships&.[](user.id) %>

  <% if rel.present? %>
    <%= button_to "フォロー中",
          relationship_path(rel),
          method: :delete,
          class: "btn btn-sm btn-outline-secondary" %>
  <% else %>
    <%= button_to "フォローする",
          relationships_path(followed_id: user.id),
          method: :post,
          class: "btn btn-sm btn-dark" %>
  <% end %>
<% end %>
