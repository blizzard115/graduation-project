<main data-controller="scrollspy" data-scrollspy-offset-value="120">
  <!-- PANEL 1 -->
  <section id="discover" class="lp-panel lp-panel--discover" data-scrollspy-target="section">
    <div class="container-fluid px-0 py-5">
      <div class="lp-inner">
        <div class="row align-items-start g-5">
          <div class="col-lg-6">
            <p class="lp-eyebrow">Stylog</p>
            <h1 class="lp-title">コーデを、もっと気軽に。</h1>
            <p class="lp-lead">写真1枚 + ひとこと。日常のスタイルを残して、みんなのコーデから発見しよう。</p>

            <div class="d-flex flex-wrap gap-3 mt-4">
              <% if user_signed_in? %>
                <%= link_to "新規投稿", new_post_path, class: "btn btn-dark btn-lg px-4" %>
              <% else %>
                <%= link_to "はじめる", new_user_registration_path, class: "btn btn-dark btn-lg px-4" %>
                <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline-dark btn-lg" %>
              <% end %>

              <%= link_to "みんなのコーデを見る", "#explore", class: "btn btn-outline-dark btn-lg" %>
            </div>
          </div>

          <div class="col-lg-6">
            <!-- 右側：Pinterestっぽいカードのコラージュ -->
            <div class="lp-collage">
              <% post_main = @collage_posts[0] %>
              <% post_sub1 = @collage_posts[1] %>
              <% post_sub2 = @collage_posts[2] %>

              <!-- メインカード -->
              <div class="lp-collage__card lp-collage__card--lg">
                <div class="lp-collage__badge">#monochrome</div>

                <% if post_main&.image&.attached? %>
                  <%= image_tag post_main.image, class: "lp-collage__img" %>
                <% else %>
                  <div class="lp-collage__mock lp-collage__mock--img"></div>
                <% end %>
              </div>

              <!-- サブ2枚 -->
              <div class="lp-collage__stack">
                <div class="lp-collage__card">
                  <% if post_sub1&.image&.attached? %>
                    <%= image_tag post_sub1.image, class: "pin__img" %>
                  <% else %>
                    <div class="lp-collage__mock lp-collage__mock--img2"></div>
                    <div class="lp-collage__caption">street</div>
                  <% end %>
                </div>

                <div class="lp-collage__card">
                  <% if post_sub2&.image&.attached? %>
                    <%= image_tag post_sub2.image, class: "pin__img" %>
                  <% else %>
                    <div class="lp-collage__mock lp-collage__mock--img3"></div>
                    <div class="lp-collage__caption">vintage</div>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="lp-scroll-indicator">
              <span>How it works</span>
              <div class="lp-scroll-mouse">
                <div class="lp-scroll-dot"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PANEL 2 -->
  <section id="how" class="lp-panel lp-panel--how" data-scrollspy-target="section">
    <div class="container-fluid px-0 py-5">
      <div class="lp-inner">
        <div class="row align-items-center g-5">
          <div class="col-lg-6">
            <p class="lp-eyebrow">How it works</p>
            <h2 class="lp-title-sm">使い方はシンプル</h2>

            <div class="lp-steps mt-4">
              <div class="lp-step">
                <div class="lp-step__num">1</div>
                <div>
                  <div class="lp-step__title">写真を選ぶ</div>
                  <div class="lp-step__text">いつものコーデを1枚。</div>
                </div>
              </div>
              <div class="lp-step">
                <div class="lp-step__num">2</div>
                <div>
                  <div class="lp-step__title">ひとことを書く</div>
                  <div class="lp-step__text">ブランドや気分をメモ。</div>
                </div>
              </div>
              <div class="lp-step">
                <div class="lp-step__num">3</div>
                <div>
                  <div class="lp-step__title">タグで見つける</div>
                  <div class="lp-step__text">好みの雰囲気に出会える。</div>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <%= link_to "#explore", class: "btn btn-outline-dark fw-semibold" do %>
                みんなのコーデを見る →
              <% end %>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="lp-mock">
              <div class="lp-mock__header">投稿プレビュー</div>

              <div class="lp-mock__body">
                <% if @preview_post.present? %>
                  <div class="lp-preview">
                    <div class="lp-preview__img-wrap">
                      <% if @preview_post.image.attached? %>
                        <%= image_tag @preview_post.image, class: "lp-preview__img" %>
                      <% else %>
                        <div class="lp-preview__img" aria-hidden="true"></div>
                      <% end %>
                    </div>

                    <div class="lp-preview__content">
                      <div class="lp-preview__caption">
                        <%= truncate(@preview_post.content.presence || "今日のコーデ", length: 40) %>
                      </div>

                      <% if @preview_post.tags.any? %>
                        <div class="lp-preview__tags">
                          <% @preview_post.tags.limit(3).each do |tag| %>
                            <span class="lp-tag"><%= tag.name %></span>
                          <% end %>
                        </div>
                      <% end %>

                      <div class="lp-preview__footer">
                        <span class="lp-preview__user">
                          @<%= @preview_post.user.username.presence || "stylog_user" %>
                        </span>
                        <span class="lp-preview__like">
                          <i class="fa-solid fa-heart"></i> <%= @preview_post.likes_count %>
                        </span>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <div class="lp-preview">
                    <div class="lp-preview__img-wrap">
                      <div class="lp-preview__img" aria-hidden="true"></div>
                    </div>

                    <div class="lp-preview__content">
                      <div class="lp-preview__caption">今日のコーデを投稿してみよう</div>
                      <div class="lp-preview__tags">
                        <span class="lp-tag">style</span>
                        <span class="lp-tag">daily</span>
                      </div>
                      <div class="lp-preview__footer">
                        <span class="lp-preview__user">@stylog_user</span>
                        <span class="lp-preview__like"><i class="fa-solid fa-heart"></i> 0</span>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PANEL 3 -->
  <section id="explore" class="lp-panel lp-panel--explore" data-scrollspy-target="section">
    <div class="container-fluid py-5">
        <div class="lp-inner">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <p class="lp-eyebrow mb-1">Explore</p>
              <h2 class="lp-title-sm mb-0">みんなのコーデ</h2>
            </div>
            <%= link_to "もっと見る →", posts_path, class: "btn btn-outline-dark" %>
          </div>


        <div class="home-masonry">
          <% @latest_posts.each_with_index do |post, i| %>
            <div class="home-masonry-item <%= 'home-masonry-item--lg' if i % 6 == 0 %>">
              <%= link_to post_path(post), class: "text-decoration-none text-dark" do %>
                <div class="pin">
                  <div class="pin__media">
                    <% if post.image.attached? %>
                      <%= image_tag post.image, class: "pin__img" %>
                    <% else %>
                      <div class="pin__placeholder">
                        No Image
                      </div>
                    <% end %>
                  </div>
                  <div class="pin__meta">
                    <span class="pin__user">@<%= post.user.username %></span>
                    <div class="pin__actions">
                      <i class="fa-regular fa-heart"></i>
                      <span><%= post.likes_count %></span>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>
</main>
